{
  "name": "vite-react-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:local": "vite --mode emulator",
    "emulators": "firebase emulators:start --only auth,firestore --import=./emulator-data --export-on-exit",
    "emulators:fresh": "firebase emulators:start --only auth,firestore --export-on-exit=./emulator-data",
    "backup": "node --env-file=.env scripts/backup-firestore.mjs",
    "import:csv": "node --env-file=.env scripts/import-csv.mjs",
    "seed": "node --env-file=.env scripts/seed-emulator.mjs",
    "export:admin": "node scripts/export-admin.mjs"
  },
  "dependencies": {
    "firebase": "^10.14.1",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^14.27.0",
    "globals": "^16.5.0",
    "vite": "^7.2.4"
  }
}
